{
  "name": "DaHorta",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "runArgs": ["--privileged"],
  "mounts": [
    "source=dahorta-docker-data,target=/var/lib/docker,type=volume"
  ],
  "forwardPorts": [3306, 4200, 8080],
  "remoteUser": "vscode"
}
